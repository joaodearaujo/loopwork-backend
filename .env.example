# .env.example
# Copy this file's contents into application-dev.properties (or your
# local .env setup) and fill in real values. Never commit real secrets.

DATABASE_URL=jdbc:postgresql://localhost:5432/loopwork
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your_local_password

JWT_SECRET=generate_with_openssl_rand_base64_32
JWT_EXPIRATION=7200000